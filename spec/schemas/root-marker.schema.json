  "$id": "https://rjduncan19.github.io/photo-haven/spec/v1/root-marker.schema.json",
  "title": "<root>/.photohaven-root.json. 03 2.2",
  "type": "object",
  "required": ["schema", "library_id", "root_id", "name", "created_at"],
