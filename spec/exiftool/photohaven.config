#------------------------------------------------------------------------------
# ExifTool config: Photo Haven provenance namespace (docs/03-format-spec.md §8.2)
#
#   Prefix: phv
#   URI:    urn:rjduncan19:photo-provenance:1.0
#
# Use:  exiftool -config photohaven.config -XMP-phv:IngestFileSHA256=<hex> FILE
# The content hash itself uses ExifTool's built-in XMP-et:OriginalImageHash and
# XMP-et:OriginalImageHashType tags, so it is not defined here.
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        phv => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::phv',
            },
        },
    },
);

%Image::ExifTool::UserDefined::phv = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-phv', 2 => 'Other' },
    NAMESPACE => { 'phv' => 'urn:rjduncan19:photo-provenance:1.0' },
    WRITABLE  => 'string',
    IngestFileSHA256 => { },
    IngestedAt       => { Groups => { 2 => 'Time' } },   # spec §1.2 string, stored verbatim
    LibraryID        => { },
    SchemaVersion    => { Writable => 'integer' },
);

1;  # end
